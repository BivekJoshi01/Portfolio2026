# Copied to dist/assets/.htaccess by deploy/deploy-local.sh.
# Vite fingerprints every file it writes under assets/ (index-xTl5zb8Z.js), so
# a changed file always gets a new name and these can be cached forever.
# Files from public/ land in the root instead and are not covered by this.

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
